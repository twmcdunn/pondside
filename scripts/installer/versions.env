# Pinned third-party inputs to the installer. Bump a version and its
# checksum together; make-installer.sh and the install scripts refuse a
# download whose SHA-256 differs.

# Bundled: built into the package.
LILYPOND_VERSION=2.26.0
# Apple silicon: built from source by build-lilypond.sh (upstream's arm64
# tarball needs macOS 26). Intel: upstream's tarball, which needs 10.15.
LILYPOND_SOURCE_URL=https://lilypond.org/download/sources/v2.26/lilypond-2.26.0.tar.gz
LILYPOND_SOURCE_SHA256=bbe82dbeba7f7f99ddcd8d1fa134a0d89cafa6e8f815fde5bb01f4208b06fe05
LILYPOND_URL_x86_64=https://gitlab.com/lilypond/lilypond/-/releases/v2.26.0/downloads/lilypond-2.26.0-darwin-x86_64.tar.gz
LILYPOND_SHA256_x86_64=6dcbca34b13ad6d4ba3606a0b48edd02688284fcd52e9c00141242df1996a148

FLUIDSYNTH_VERSION=2.6.1
FLUIDSYNTH_URL=https://github.com/FluidSynth/fluidsynth/archive/refs/tags/v2.6.1.tar.gz
FLUIDSYNTH_SHA256=3d258a3bf97cc20c59eeebfe62c2432fae88adda74d3ad098681c76e0ebf446b
LIBSNDFILE_URL=https://github.com/libsndfile/libsndfile/releases/download/1.2.2/libsndfile-1.2.2.tar.xz
LIBSNDFILE_SHA256=3799ca9924d3125038880367bf1468e53a1b7e3686a934f098b7e1d286cdb80e

# GeneralUser GS 2.0.3; its licence asks for a local copy, not a link to
# the author's downloads, so it is bundled rather than fetched at install.
SOUNDFONT_URL=https://raw.githubusercontent.com/mrbumpy409/GeneralUser-GS/684543d5e5efaef08d02be50dcda8d552478fa60/GeneralUser-GS.sf2
SOUNDFONT_LICENSE_URL=https://raw.githubusercontent.com/mrbumpy409/GeneralUser-GS/684543d5e5efaef08d02be50dcda8d552478fa60/documentation/LICENSE.txt
SOUNDFONT_SHA256=9575028c7a1f589f5770fccc8cff2734566af40cd26ed836944e9a5152688cfe

# Downloaded at install time, only when ticked. The Team ID is checked
# against the downloaded app's Developer ID signature as well.
SUPERCOLLIDER_VERSION=3.14.1
SUPERCOLLIDER_URL=https://github.com/supercollider/supercollider/releases/download/Version-3.14.1/SuperCollider-3.14.1-macOS-universal.dmg
SUPERCOLLIDER_SHA256=ed264b32752d27fc86e506dd0a7eb36de7c19ebce73c3fdf2ed5514f8c73f02e
SUPERCOLLIDER_TEAM=HE5VJFE9E4
SUPERCOLLIDER_APP=SuperCollider.app

MUSESCORE_VERSION=4.7.6
MUSESCORE_URL=https://github.com/musescore/MuseScore/releases/download/v4.7.6/MuseScore-Studio-4.7.6.261022093.dmg
MUSESCORE_SHA256=dd78357e652a4df6ec074b9bd63a79e09eedb7c1c9dd6262eb7d9304508dec9c
MUSESCORE_TEAM=6EPAF2X3PR
MUSESCORE_APP="MuseScore 4.app"

# Agents (Claude Code, opencode), installed only when ticked, into the
# person's home by the vendor's own install script at a pinned version. The
# script itself is pinned by SHA-256: if the vendor has changed it since, the
# agent is skipped (logged; install it later with the vendor's command).
CLAUDE_VERSION=2.1.314
CLAUDE_INSTALL_URL=https://claude.ai/install.sh
CLAUDE_INSTALL_SHA256=3a68d3406cf674e17bed1733a4dcf37805e2e47d87417700007d7e1aa766a944
CLAUDE_ARGS="$CLAUDE_VERSION"
CLAUDE_BIN=.local/bin/claude
OPENCODE_VERSION=1.19.4
OPENCODE_INSTALL_URL=https://opencode.ai/install
OPENCODE_INSTALL_SHA256=a2dd59522b9a091b6cdb2e4870c0f2135f7da09807cd5a7e04222d4316925b72
OPENCODE_ARGS="--version $OPENCODE_VERSION"
OPENCODE_BIN=.opencode/bin/opencode
